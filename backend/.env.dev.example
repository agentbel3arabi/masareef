# Local development: Postgres from docker-compose.dev.yml, Supabase for auth only.
# Copy to .env and fill in the four SUPABASE_* values from your Supabase project settings.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/masareef

APP_ENV=development
